{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "PublishTimeoutSeconds": 5
  },
  "Outbox": {
    "PollIntervalSeconds": 1,
    "BatchSize": 20,
    "RetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 300
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
